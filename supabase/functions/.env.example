# Edge Function secrets. Set them with:
#   npx supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.)

# Random string shared with pg_cron / GitHub Actions. Generate: openssl rand -hex 32
CRON_SECRET=

# Public URL of the deployed app, used for links in emails and CORS
APP_URL=https://your-app.vercel.app

# Web Push (npm run gen:vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional shared Telegram bot (users can also bring their own bot token)
TELEGRAM_BOT_TOKEN=

# Email: choose ONE provider
#  smtp  → e.g. Gmail with an App Password. Port 465 only (25/587 are blocked on Edge Functions).
#  brevo → Brevo free plan, 300 emails/day, verify a single sender address (no domain needed).
EMAIL_PROVIDER=smtp
EMAIL_FROM=you@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=
BREVO_API_KEY=

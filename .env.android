# Build settings for the personal Android app (npm run android:build).
# Public values only. Supabase URL/key still come from .env.local.
# (Jarvis itself is switched on by the "android" build mode, see vite.config.ts.)
VITE_NATIVE=1
# emailed links (sign-up, password reset) must point at the live site, not the app's https://localhost
VITE_SITE_URL=https://lakshya-ved.vercel.app

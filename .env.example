# ---- Frontend (safe to expose: these are PUBLIC values) ----
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Generate with: npm run gen:vapid  (public half only goes here)
VITE_VAPID_PUBLIC_KEY=

# NEVER put the service role key, SMTP password, Telegram token or VAPID
# private key in this file. Those are Supabase Edge Function secrets – see
# supabase/functions/.env.example and README.md.
